    class CFG,ORCH,KGC control;
    class CLIENT,EVAL client;
    class AGG,COMBINE crypto;
    class ICHAIN,RELAY_OUT,ACHAIN,RELAY_BACK chain;
    class METRICS,ARTIFACTS,TESTS evidence;
